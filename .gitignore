.DS_Store
__pycache__/
*.py[cod]

# Claude Code local permissions/settings
.claude/settings.local.json

# Raven self-install state — config and manifest are tracked; session files are not
.raven/session.md
.raven/session.lock
.raven/session.tmp
.raven/session-archive.md

# Transient guided-merge helpers; review then delete (never commit)
.raven/merge/

# Local working notes
SCRATCH*.md
TODO.md

# Local Claude session memory
.remember/

# Tool-installed local agent skills; regenerate with GitNexus when needed.
# GitNexus writes one directory per skill (gitnexus-cli/, gitnexus-guide/,
# etc.), not a single gitnexus/ directory, so the pattern must match both
# the current per-skill shape and the older single-directory one.
.agents/skills/gitnexus/
.agents/skills/gitnexus-*/

# Machine-local just recipes, pulled in by `import? 'private.just'`
private.just
