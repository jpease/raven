#!/usr/bin/env python3
"""commit-msg hook: strip AI agent attribution trailers before they land in git history."""

from __future__ import annotations

import importlib.util
import re
import subprocess
import sys
from importlib.machinery import SourceFileLoader
from pathlib import Path

# Match AI attribution trailers: Co-Authored-By/Generated-by naming a known AI tool or provider
# domain, or a bot's literal "noreply@" address (catches unlisted/future tools without
# naming them -- GitHub's own human co-author suggestion uses "<id+user@users.noreply...>",
# which does not start with "noreply@" and so is not matched), or the Claude-session link
# trailer injected by the Claude Code system prompt.
_AI_TRAILER = re.compile(
    r"^(?:co-authored-by|generated-by):\s+.*"
    r"(?:(?:claude|copilot|codex|chatgpt|gpt-[0-9]+|gemini|llama|mistral"
    r"|@anthropic\.com|@openai\.com)"
    r"|<noreply@[^>]+>)"
    r"|^claude-session:\s+\S+",
    re.IGNORECASE,
)


def _raven_config_module():
    """Import the ``lib/raven_config.py`` sibling of this hook's own directory.

    This script (``.raven/git-hooks/commit-msg``) and the shared parser
    (``.raven/git-hooks/lib/raven_config.py``) always ship together in the
    "hooks" component, one level apart -- resolved via this file's own
    location, not the repo root ``_repo_root()`` below computes for the
    config file itself, so those two lookups can vary independently (a test
    fixture can point ``_repo_root()`` at an isolated repo without needing a
    full install alongside it).
    """
    path = Path(__file__).resolve().parent / "lib" / "raven_config.py"
    spec = importlib.util.spec_from_file_location(
        "raven_config_for_commit_msg",
        path,
        loader=SourceFileLoader("raven_config_for_commit_msg", str(path)),
    )
    if spec is None or spec.loader is None:
        raise ImportError(f"could not load raven_config from {path}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    return module


def _read_config_bool(config_path: Path, section: str, key: str, default: bool) -> bool:
    """Read a boolean flag from ``config_path``, defaulting on anything short of a clean read.

    Previously this had no ``try``/``except`` around ``read_text()``: a
    present-but-unreadable config propagated an uncaught ``OSError`` out of
    the hook, failing the commit outright. That was never an intentional
    failure semantic here -- a missing file, a missing section, a missing
    key, and a non-boolean value all already fell back to ``default`` -- so
    it is fixed here to do the same, via the shared parser's
    ``RavenConfigError``, rather than preserved.
    """
    raven_config = _raven_config_module()
    try:
        parsed = raven_config.read_config(config_path)
    except raven_config.RavenConfigError:
        return default
    if parsed is None:
        return default
    raw_value = parsed.get(section, {}).get(key)
    if raw_value is None:
        return default
    parsed_value = raven_config.parse_bool(raw_value)
    return default if parsed_value is None else parsed_value


def _repo_root() -> Path | None:
    try:
        result = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            capture_output=True,
            text=True,
            check=True,
        )
        return Path(result.stdout.strip())
    except subprocess.CalledProcessError:
        return None


def main() -> int:
    root = _repo_root()
    if root is not None:
        config = root / ".raven" / "config.toml"
        if not _read_config_bool(config, "git_hooks", "strip_ai_attribution", default=True):
            return 0

    msg_file = Path(sys.argv[1])
    try:
        lines = msg_file.read_text(encoding="utf-8").splitlines()
    except UnicodeDecodeError:
        # Cosmetic hook: fail open rather than block a commit over an encoding we can't read.
        return 0

    removed = [line for line in lines if _AI_TRAILER.match(line)]
    if not removed:
        return 0

    cleaned = [line for line in lines if not _AI_TRAILER.match(line)]
    while cleaned and not cleaned[-1].strip():
        cleaned.pop()

    msg_file.write_text("\n".join(cleaned) + "\n", encoding="utf-8")
    for trailer in removed:
        print(f"raven commit-msg: removed AI attribution: {trailer}", file=sys.stderr)

    return 0


if __name__ == "__main__":
    sys.exit(main())
